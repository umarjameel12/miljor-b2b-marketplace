# MilJor Frontend Environment Template
# Copy to .env.local for local overrides if needed. NEVER commit secrets.
# Only public identifiers are safe in VITE_* variables.

# Public Google OAuth Web Client ID (optional — automatically fetched from /api/v1/auth/google/config if omitted)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

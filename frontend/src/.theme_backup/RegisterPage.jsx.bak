import React, { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';
import { Logo } from '../components/ui/Logo';
import { Button } from '../components/ui/Button';
import { Input } from '../components/ui/Input';
import { toast } from 'react-toastify';
import { Mail, Lock, Phone, Building2, User, MapPin, AlertCircle } from 'lucide-react';
import FLAGS from '../config/featureFlags';

const PROCUREMENT_REGIONS = [
  'Lahore — Gulberg & Central',
  'Lahore — DHA & Cantt',
  'Lahore — Johar Town & Model Town',
  'Lahore — Anarkali / Old City',
  'Lahore — Badami Bagh / Industrial',
  'Karachi — Central Commercial',
  'Islamabad / Rawalpindi',
  'Faisalabad',
  'Other Commercial Region',
];

export const RegisterPage = () => {
  const [formData, setFormData] = useState({
    business_name: '',
    full_name: '',
    email: '',
    phone: '',
    password: '',
    area: 'Lahore — Gulberg & Central',
    address: '',
  });

  const [error, setError] = useState(null);
  const [loading, setLoading] = useState(false);

  const { register } = useAuth();
  const navigate = useNavigate();

  // Password validation helpers matching backend invariants
  const isLengthValid = formData.password.length >= 8;
  const hasLetter = /[a-zA-Z]/.test(formData.password);
  const hasNumber = /[0-9]/.test(formData.password);
  const isPasswordValid = isLengthValid && hasLetter && hasNumber;

  // Phone validation: exactly 11 digits when provided
  const cleanPhone = formData.phone.replace(/\D/g, '');

  const handleChange = (e) => {
    const { name, value } = e.target;
    if (name === 'phone') {
      const digitsOnly = value.replace(/\D/g, '').slice(0, 11);
      setFormData((prev) => ({ ...prev, phone: digitsOnly }));
      return;
    }
    setFormData((prev) => ({ ...prev, [name]: value }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError(null);

    if (!formData.email) {
      setError('A valid business email address is required.');
      return;
    }

    if (formData.phone && !/^[0-9]{11}$/.test(cleanPhone)) {
      setError('Phone number must be exactly 11 digits (e.g. 03001234567).');
      return;
    }

    if (!isPasswordValid) {
      setError('Password must be at least 8 characters and contain letters and numbers.');
      return;
    }

    setLoading(true);
    try {
      const res = await register(formData);
      if (res.requires_verification) {
        toast.success('Account created. Please check your email for the 6-digit verification code.');
        navigate('/verify-email', { state: { email: formData.email } });
      } else {
        toast.success('Account registered successfully. Welcome to MilJor.');
        navigate('/pools');
      }
    } catch (err) {
      const msg = err.response?.data?.error?.message || err.message || 'Registration failed';
      setError(msg);
      toast.error(msg);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div
      className="min-h-[calc(100vh-5rem)] flex items-center justify-center p-4 sm:p-6 lg:p-8 transition-colors duration-300 relative overflow-hidden"
      style={{ background: 'var(--bg-auth)' }}
    >
      <div
        className="w-full max-w-lg p-8 sm:p-10 rounded-3xl auth-box-enhanced flex flex-col gap-6 relative z-10"
      >
        {/* Top Branding with Refined Champagne-Gold Ribbon M Monogram */}
        <div className="flex flex-col items-center text-center">
          <Link to="/" aria-label="MilJor Home" className="mb-4">
            <Logo variant="monogram" size="lg" />
          </Link>

          <h2
            className="font-display font-black text-2xl tracking-tight"
            style={{ color: 'var(--text-primary)' }}
          >
            Create Buyer Account
          </h2>
          <p className="text-xs font-sans mt-1" style={{ color: 'var(--text-muted)' }}>
            Join restaurants and commercial kitchens pooling wholesale demand
          </p>
        </div>

        {/* Error Alert */}
        {error && (
          <div
            className="p-3.5 rounded-xl border flex items-start gap-2.5 text-xs"
            style={{
              backgroundColor: 'var(--status-danger-bg)',
              borderColor: 'var(--status-danger)',
              color: 'var(--status-danger)',
            }}
            role="alert"
          >
            <AlertCircle className="w-4 h-4 shrink-0 mt-0.5" />
            <div className="flex-1">
              <span className="font-semibold block">Registration Notice</span>
              <span className="mt-0.5 block">{error}</span>
            </div>
          </div>
        )}

        {/* Registration Form */}
        <form onSubmit={handleSubmit} className="flex flex-col gap-4">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <Input
              label="Business Name"
              type="text"
              name="business_name"
              placeholder="e.g. Al-Madina Caterers"
              value={formData.business_name}
              onChange={handleChange}
              icon={Building2}
              required
            />

            <Input
              label="Authorized Contact Name"
              type="text"
              name="full_name"
              placeholder="e.g. Tariq Mehmood"
              value={formData.full_name}
              onChange={handleChange}
              icon={User}
              required
            />
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <Input
              label="Business Email"
              type="email"
              name="email"
              autoComplete="email"
              placeholder="tariq@almadina.pk"
              value={formData.email}
              onChange={handleChange}
              icon={Mail}
              required
            />

            <Input
              label="Mobile Number (11 digits)"
              type="tel"
              name="phone"
              autoComplete="tel"
              placeholder="03001234567"
              value={formData.phone}
              onChange={handleChange}
              icon={Phone}
              helperText="For SMS delivery dispatch notifications"
            />
          </div>

          {/* Area & Delivery Dropdown */}
          <div className="flex flex-col gap-1.5">
            <label
              htmlFor="register-area-select"
              className="text-xs font-sans font-medium flex items-center gap-1.5"
              style={{ color: 'var(--text-secondary)' }}
            >
              <MapPin className="w-3.5 h-3.5 text-stone-400" />
              <span>Procurement & Delivery Region</span>
            </label>
            <select
              id="register-area-select"
              name="area"
              value={formData.area}
              onChange={handleChange}
              className="w-full px-3.5 py-2.5 rounded-xl border text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-[var(--brand-accent)]"
              style={{
                backgroundColor: 'var(--bg-input)',
                borderColor: 'var(--border-default)',
                color: 'var(--text-primary)',
              }}
            >
              {PROCUREMENT_REGIONS.map((a) => (
                <option key={a} value={a}>
                  {a}
                </option>
              ))}
            </select>
          </div>

          <Input
            label="Street / Commercial Address"
            type="text"
            name="address"
            placeholder="e.g. Shop 4B, Main Market, Gulberg II"
            value={formData.address}
            onChange={handleChange}
            icon={MapPin}
          />

          <Input
            label="Account Password"
            type="password"
            name="password"
            autoComplete="new-password"
            placeholder="At least 8 characters with letters & numbers"
            value={formData.password}
            onChange={handleChange}
            icon={Lock}
            required
            helperText={
              <span className="flex items-center gap-3">
                <span className={isLengthValid ? 'text-emerald-700 dark:text-emerald-400 font-medium' : 'text-stone-400'}>
                  • 8+ chars
                </span>
                <span className={hasLetter ? 'text-emerald-700 dark:text-emerald-400 font-medium' : 'text-stone-400'}>
                  • Letter
                </span>
                <span className={hasNumber ? 'text-emerald-700 dark:text-emerald-400 font-medium' : 'text-stone-400'}>
                  • Number
                </span>
              </span>
            }
          />

          {FLAGS.passwordStrengthMeter && formData.password.length > 0 && (
            <div className="flex items-center gap-1.5 -mt-2 mb-1">
              <div
                className="h-1.5 flex-1 rounded-full transition-all duration-300"
                style={{
                  backgroundColor: isLengthValid ? 'var(--brand-emerald)' : 'var(--status-danger)',
                }}
              />
              <div
                className="h-1.5 flex-1 rounded-full transition-all duration-300"
                style={{
                  backgroundColor: isLengthValid && hasLetter ? 'var(--brand-emerald)' : 'rgba(150, 150, 150, 0.25)',
                }}
              />
              <div
                className="h-1.5 flex-1 rounded-full transition-all duration-300"
                style={{
                  backgroundColor: isPasswordValid ? 'var(--brand-emerald)' : 'rgba(150, 150, 150, 0.25)',
                }}
              />
              <span className="text-[10px] font-sans font-semibold text-stone-500 pl-1">
                {isPasswordValid ? 'Strong' : isLengthValid ? 'Good' : 'Weak'}
              </span>
            </div>
          )}

          <Button
            type="submit"
            variant="primary"
            size="lg"
            loading={loading}
            className="w-full mt-2 font-semibold shadow-xs justify-center"
            style={{
              backgroundColor: 'var(--brand-accent)',
              color: 'var(--text-on-champagne)',
            }}
          >
            Create Account
          </Button>
        </form>

        {/* Existing Member Link */}
        <div className="text-center pt-2 border-t" style={{ borderColor: 'var(--border-subtle)' }}>
          <p className="text-xs font-sans" style={{ color: 'var(--text-muted)' }}>
            Already have an account?{' '}
            <Link
              to="/login"
              className="font-bold hover:underline"
              style={{ color: 'var(--brand-accent)' }}
            >
              Sign In
            </Link>
          </p>
        </div>
      </div>
    </div>
  );
};

export default RegisterPage;

# =============================================================================
# MILJOR B2B MARKETPLACE — SANITIZED ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure per environment. NEVER commit real credentials.
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development # development | test | sandbox | production

# Reverse Proxy & CORS
TRUST_PROXY=false # Set to true or CIDR subnet (e.g. 10.0.0.0/8) if behind ALB/Nginx
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173 # Comma-separated list; wildcard forbidden in production

# Database Configuration (Development / Production Target)
DB_HOST=localhost
DB_PORT=3306
DB_USER=miljor_app
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_NAME=miljor_db

# Isolated Automated Test & Persistent Sandbox Targets
TEST_DB_NAME=miljor_test_db
SANDBOX_DB_NAME=miljor_sandbox_db

# Security & Authentication (JWT & OTP HMAC)
# In production, secrets must be at least 32 cryptographically random characters
JWT_SECRET=YOUR_CRYPTOGRAPHICALLY_RANDOM_SECRET_MIN_32_CHARS_HERE
OTP_HMAC_SECRET=YOUR_DEDICATED_OTP_HMAC_SECRET_MIN_32_CHARS_HERE

# Payment Gateway (Safepay Sandbox / Production)
SAFEPAY_ENV=sandbox # sandbox | production
SAFEPAY_PUBLIC_KEY=sec_sand_placeholder_public_key
SAFEPAY_SECRET_KEY=sec_sand_placeholder_secret_key
SAFEPAY_WEBHOOK_SECRET=sec_sand_placeholder_webhook_secret

# Financial Safety Invariant — Money Movement Adapter Status
ALLOW_EXTERNAL_MONEY_MOVEMENT=false # Strictly false until formal commercial licensing

# Logging Configuration
ENABLE_VERBOSE_LOGS=false

# Google Identity Services (OpenID Connect / OAuth 2.0)
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_IF_USING_CODE_FLOW
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Transactional Email & Outbox Delivery (Gmail / SMTP Relay)
TRANSACTIONAL_EMAIL_MODE=smtp # mock | smtp
EMAIL_FROM="MilJor Notifications" <noreply@miljor.com>
SMTP_HOST=smtp.gmail.com # or custom SMTP relay (e.g. smtp.sendgrid.net)
SMTP_PORT=587 # 465 for SSL, 587 for TLS/STARTTLS
SMTP_SECURE=false # true for port 465, false for 587
SMTP_USER=notifications@miljor.com # or your Gmail address
SMTP_PASS=YOUR_16_CHAR_GMAIL_APP_PASSWORD_HERE

SMS_API_KEY=YOUR_SMS_API_KEY_HERE
SMS_SENDER=MilJor

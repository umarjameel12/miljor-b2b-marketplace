{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/master_regression_runner.js",
    "test:hardening": "node tests/b6_backend_hardening_source_gate.js && node tests/canonical_family_discovery_gate.js",
    "test:b6": "node tests/b6_release_gate.js",
    "test:release": "npm test && npm run test:b6 && npm run test:ucp && npm --prefix ../frontend run build",
    "test:ucp": "npm run test:ucp:audit && node tests/b4_regular_dual_timer_source_gate.js && node tests/ucp_unified_supplier_pools_source_gate.js && node tests/ucp_3_to_5_source_gate.js",
    "test:ucp:audit": "node tests/ucp_independent_audit_source_gate.js",
    "migration:preflight": "node database/migrationManifest.js",
    "test:p0:commission:source": "node tests/p0_four_track_commission_source_gate.js",
    "test:canonical:preflight": "node tests/canonical_migration_manifest_gate.js && npm run test:ucp",
    "test:canonical:release": "npm run test:canonical:preflight && npm run test:b6 && npm --prefix ../frontend run build",
    "test:ucp:reconciliation": "node database/financeCompatibilityGate.js && node tests/ucp_thischat_reconciliation_gate.js",
    "migration:audit:test": "node database/readOnlyMigrationAudit.js --test-only",
    "test:ucp:ci": "npm run migration:preflight && npm run test:ucp:reconciliation && npm run test:ucp && npm --prefix ../frontend run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.14"
  }
}
